{
  "name": "transflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "migrate": "pnpm --filter @transflow/db migrate",
    "migrate:create": "pnpm --filter @transflow/db migrate:create",
    "migrate:dry-run": "pnpm --filter @transflow/db migrate:dry-run",
    "migrate:down": "pnpm --filter @transflow/db migrate:down",
    "migrate:redo": "pnpm --filter @transflow/db migrate:redo"
  },
  "engines": {
     "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
